{
  "name": "gaine-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "format": "node scripts/format-sources.mjs",
    "format:check": "node scripts/format-sources.mjs --check",
    "test": "pnpm build && pnpm -r --workspace-concurrency=1 test",
    "pack:local": "node scripts/pack-tarballs.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
