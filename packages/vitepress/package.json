{
  "name": "@gaine/vitepress",
  "version": "0.2.0",
  "description": "Gaine for VitePress (Vue 3): ThemeSync, ScrollReveal, LanguageSwitcher, Logo, ThemeToggle, locale redirect, robots/sitemap, and OG images. Speed layer: withGaineSpeed, MPA mode, inline runtime, speculation rules.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./head": {
      "types": "./dist/head.d.ts",
      "import": "./dist/head.js",
      "default": "./dist/head.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    },
    "./og": {
      "types": "./dist/og.d.ts",
      "import": "./dist/og.js",
      "default": "./dist/og.js"
    },
    "./speed": {
      "types": "./dist/speed.d.ts",
      "import": "./dist/speed.js",
      "default": "./dist/speed.js"
    },
    "./vitepress.css": "./styles/vitepress.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test"
  },
  "dependencies": {
    "@gaine/core": "workspace:^"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.0",
    "satori": ">=0.12.0",
    "vitepress": ">=1.5.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "satori": {
      "optional": true
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "satori": "^0.12.0",
    "typescript": "^5.7.2",
    "vitepress": "^1.6.3",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
