{
  "name": "@gaine/core",
  "version": "0.1.2",
  "description": "Framework-free core for Gaine, with no React or Vue lock-in",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind/index.d.ts",
      "import": "./dist/tailwind/index.js",
      "default": "./dist/tailwind/index.js"
    },
    "./reveal.css": "./styles/reveal.css",
    "./speed": {
      "types": "./dist/speed/index.d.ts",
      "import": "./dist/speed/index.js",
      "default": "./dist/speed/index.js"
    },
    "./speed/node": {
      "types": "./dist/speed/node.d.ts",
      "import": "./dist/speed/node.js",
      "default": "./dist/speed/node.js"
    },
    "./speed.css": "./styles/speed.css",
    "./view-transition.css": "./styles/view-transition.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly --sourceMap false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
