{
  "name": "create-gaine",
  "version": "0.1.1",
  "description": "Scaffold a Gaine project for Next.js or VitePress and TypeScript or JavaScript",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "create-gaine": "./dist/cli.js",
    "gaine": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
